# Install outside Git with mode 0600. Supply nonempty values through the approved channel.
HIVE_DATABASE_URL=postgresql://hive_app@pg.staging.example.invalid:5432/hive_staging?sslmode=verify-full&sslrootcert=/run/hive/pg-ca.pem
HIVE_DB_MAX_CONNECTIONS=12
HIVE_APP_ORIGIN=https://app.staging.example.invalid
HIVE_ADMIN_ORIGIN=https://admin.staging.example.invalid
HIVE_GOOGLE_REDIRECT_URL=https://api.staging.example.invalid/api/v1/oidc/google/callback
HIVE_GOOGLE_CLIENT_ID=
HIVE_GOOGLE_CLIENT_SECRET=
HIVE_RECEIPT_HMAC_KEY=
HIVE_DEVICE_PAIRING_CODE_KEY=
HIVE_SMTP_ADDRESS=smtp.example.invalid:465
HIVE_SMTP_USER=
HIVE_SMTP_PASSWORD=
HIVE_SMTP_FROM=hive-staging@example.invalid
# Optional. Install scoped PIN keys when staging exercises DV3.
HIVE_PIN_PEPPER=
HIVE_PIN_PEPPER_VERSION=
